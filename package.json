{
  "name": "phosphor",
  "version": "0.1.0",
  "description": "A picture drawn as a breathing grid of dithered LED dots, in one WebGL1 shader",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "src/phosphor.ts",
  "exports": {
    ".": "./src/phosphor.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build:web": "esbuild web/app.ts --bundle --format=esm --target=es2017 --sourcemap --outfile=web/dist/app.js",
    "web": "npm run build:web && python3 tools/phosphor_web.py"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "typescript": "~5.9.3"
  }
}
